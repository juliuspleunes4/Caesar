{
  "name": "caesar-language-server",
  "version": "1.0.0",
  "description": "Language Server Protocol implementation for the Caesar Programming Language",
  "main": "out/server.js",
  "bin": {
    "caesar-language-server": "./out/server.js"
  },
  "scripts": {
    "compile": "tsc -p .",
    "build": "npm run compile",
    "start": "node ./out/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "tsc -w -p ."
  },
  "keywords": [
    "caesar",
    "language-server",
    "lsp",
    "programming-language"
  ],
  "author": "Julius Pleunes",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "typescript": "^5.2.0"
  }
}
