{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Caesar",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#classes"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#builtin-functions"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.hash.caesar",
					"begin": "#",
					"end": "$"
				},
				{
					"name": "comment.line.double-slash.caesar",
					"begin": "//",
					"end": "$"
				},
				{
					"name": "comment.block.caesar",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.caesar",
					"match": "\\b(if|elif|else|while|for|in|break|continue|return|pass)\\b"
				},
				{
					"name": "keyword.operator.logical.caesar",
					"match": "\\b(and|or|not)\\b"
				},
				{
					"name": "keyword.other.caesar",
					"match": "\\b(def|class|import|from|as|try|except|finally|with|yield|lambda)\\b"
				},
				{
					"name": "constant.language.caesar",
					"match": "\\b(True|False|None|null|true|false)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arithmetic.caesar",
					"match": "\\+|\\-|\\*|\\/|\\%|\\*\\*|\\/\\/"
				},
				{
					"name": "keyword.operator.comparison.caesar",
					"match": "==|!=|<|>|<=|>=|<>"
				},
				{
					"name": "keyword.operator.assignment.caesar",
					"match": "=|\\+=|\\-=|\\*=|\\/=|\\%="
				},
				{
					"name": "keyword.operator.bitwise.caesar",
					"match": "&|\\||\\^|~|<<|>>"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.caesar",
					"match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
				},
				{
					"name": "constant.numeric.integer.caesar",
					"match": "\\b\\d+\\b"
				},
				{
					"name": "constant.numeric.hex.caesar",
					"match": "\\b0[xX][0-9a-fA-F]+\\b"
				},
				{
					"name": "constant.numeric.binary.caesar",
					"match": "\\b0[bB][01]+\\b"
				},
				{
					"name": "constant.numeric.octal.caesar",
					"match": "\\b0[oO][0-7]+\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.triple.double.caesar",
					"begin": "\"\"\"",
					"end": "\"\"\"",
					"patterns": [
						{
							"name": "constant.character.escape.caesar",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.triple.single.caesar",
					"begin": "'''",
					"end": "'''",
					"patterns": [
						{
							"name": "constant.character.escape.caesar",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.double.caesar",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.caesar",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.single.caesar",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.caesar",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.caesar",
					"begin": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
					"beginCaptures": {
						"1": {
							"name": "keyword.other.caesar"
						},
						"2": {
							"name": "entity.name.function.caesar"
						}
					},
					"end": ":",
					"patterns": [
						{
							"include": "#function-parameters"
						}
					]
				}
			]
		},
		"function-parameters": {
			"patterns": [
				{
					"name": "variable.parameter.caesar",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
				}
			]
		},
		"classes": {
			"patterns": [
				{
					"name": "entity.name.class.caesar",
					"begin": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
					"beginCaptures": {
						"1": {
							"name": "keyword.other.caesar"
						},
						"2": {
							"name": "entity.name.class.caesar"
						}
					},
					"end": ":"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.other.caesar",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
				}
			]
		},
		"builtin-functions": {
			"patterns": [
				{
					"name": "support.function.builtin.caesar",
					"match": "\\b(print|len|range|int|float|str|bool|list|dict|set|tuple|type|input|abs|max|min|sum|sorted|reversed|enumerate|zip|map|filter|any|all)\\b"
				}
			]
		}
	},
	"scopeName": "source.caesar"
}