# Simple Loop Examples in Caesar
# This example works with both interpreter and C compilation

# While loop counting
print("Counting with while loop:")
count = 0
while count < 5:
    print("Count:", count)
    count = count + 1

print("---")

# For loop with range
print("Counting with for loop:")
for i in range(5):
    print("Iteration:", i)

print("---")

# For loop with start and stop
print("Range with start and stop:")
for i in range(3, 8):
    print("Value:", i)

print("---")

# For loop with step
print("Counting by twos:")
for i in range(0, 10, 2):
    print("Even number:", i)

print("---")

# Nested loops
print("Multiplication table (3x3):")
for i in range(1, 4):
    for j in range(1, 4):
        product = i * j
        print(i, "*", j, "=", product)
