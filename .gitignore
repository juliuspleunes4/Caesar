# Build directories
build/
lib/
_codeql_build_dir/
_codeql_detected_source_root

# Release artifacts (keep current releases only)
release/archive/
release/test-*/

# Compiled object files
*.o
*.a
*.so
*.dylib

# Executable files
*.exe
/caesar
/caesar_repl

# MinGW runtime DLLs (copied during build/install)
bin/*.dll
bin/lib*.dll

# Debug executables (but allow .gitkeep)
debug/bin/*.exe

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake

# IDE files (keep shared project configurations)
.vscode/settings.json
.vscode/launch.json
.vscode/c_cpp_properties.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
/tmp/
temp_*/

# Test files in root (keep organized test files in tests/ and examples/)
/test_*.csr
/caesar_demo*.csr

# Documentation generated files
docs/html/
docs/latex/
docs/xml/

node_modules/