# ============================================================================
# TEST 5: Recursive Fibonacci with Memoization Pattern
# ============================================================================
print("TEST 5: Recursive Fibonacci")

def fib(n):
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

print(fib(0))                # Expected: 0
print(fib(1))                # Expected: 1
print(fib(5))                # Expected: 5
print(fib(10))               # Expected: 55
print(fib(12))               # Expected: 144

# ============================================================================
# TEST 6: Tail Recursion (Sum)
# ============================================================================
print("TEST 6: Tail Recursion")

def sum_to(n):
    if n <= 0:
        return 0
    return n + sum_to(n - 1)

print(sum_to(0))             # Expected: 0
print(sum_to(10))            # Expected: 55
print(sum_to(100))           # Expected: 5050

# ============================================================================
# TEST 7: Multiple Mutual Recursion (Three Functions)
# ============================================================================
print("TEST 7: Triple Mutual Recursion")

def a(n):
    if n <= 0:
        return 1
    return b(n - 1) + 1

def b(n):
    if n <= 0:
        return 2
    return c(n - 1) + 1

def c(n):
    if n <= 0:
        return 3
    return a(n - 1) + 1

print(a(0))                  # Expected: 1
print(b(0))                  # Expected: 2
print(c(0))                  # Expected: 3
print(a(1))                  # Expected: 3
print(b(1))                  # Expected: 4
print(c(1))                  # Expected: 2
print(a(5))                  # Expected: 7
print(b(5))                  # Expected: 8
print(c(5))                  # Expected: 6

# ============================================================================
# TEST 8: Nested Function Calls with Recursion
# ============================================================================
print("TEST 8: Nested Recursive Calls")

def power(base, exp):
    if exp == 0:
        return 1
    if exp == 1:
        return base
    return base * power(base, exp - 1)

def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def combine(x, y):
    return power(factorial(x), y)

print(power(2, 0))           # Expected: 1
print(power(2, 5))           # Expected: 32
print(power(3, 3))           # Expected: 27
print(factorial(0))          # Expected: 1
print(factorial(5))          # Expected: 120
print(factorial(7))          # Expected: 5040
print(combine(3, 2))         # Expected: 36 (6^2)
print(combine(4, 1))         # Expected: 24 (24^1)

# ============================================================================
# TEST 9: Recursive Countdown Functions
# ============================================================================
print("TEST 9: Countdown Recursion")

def countdown(n):
    if n <= 0:
        return 0
    print(n)
    return countdown(n - 1)

def countdown_sum(n):
    if n <= 0:
        return 0
    return n + countdown_sum(n - 1)

print(countdown(5))          # Expected: prints 5 4 3 2 1, returns 0
print(countdown_sum(10))     # Expected: 55

# ============================================================================
# TEST 10: Complex Forward Declaration Chain
# ============================================================================
print("TEST 10: Forward Declaration Chain")

def first():
    return second() + 1

def second():
    return third() + 1

def third():
    return fourth() + 1

def fourth():
    return 10

print(first())               # Expected: 13
print(second())              # Expected: 12
print(third())               # Expected: 11
print(fourth())              # Expected: 10

# ============================================================================
# TEST 11: Recursion with Mixed Types
# ============================================================================
print("TEST 11: Mixed Type Recursion")

def countdown_float(n):
    if n <= 0.0:
        return 0.0
    return n + countdown_float(n - 1.0)

def alternating_sum(n):
    if n <= 0:
        return 0
    if n % 2 == 0:
        return n + alternating_sum(n - 1)
    return -n + alternating_sum(n - 1)

print(countdown_float(5.0))  # Expected: 15
print(countdown_float(10.0)) # Expected: 55
print(alternating_sum(1))    # Expected: -1
print(alternating_sum(5))    # Expected: 3
print(alternating_sum(10))   # Expected: 5

# ============================================================================
# TEST 12: Additional C Keywords in Recursive Context
# ============================================================================
print("TEST 12: More C Keywords Recursively")

def union_func(n):
    if n <= 0:
        return 0
    return n + struct_func(n - 1)

def struct_func(n):
    if n <= 0:
        return 0
    return n + enum_helper(n - 1)

def enum_helper(n):
    if n <= 0:
        return 0
    return n

print(union_func(5))         # Expected: 15
print(struct_func(4))        # Expected: 10
print(enum_helper(3))        # Expected: 3

# ============================================================================
# TEST 13: Maximum Recursion Depth Test
# ============================================================================
print("TEST 13: Deep Recursion Stress")

def deep_sum(n):
    if n <= 0:
        return 0
    return n + deep_sum(n - 1)

print(deep_sum(50))          # Expected: 1275
print(deep_sum(100))         # Expected: 5050
print(deep_sum(200))         # Expected: 20100

# ============================================================================
# TEST 14: Recursive Helper Pattern
# ============================================================================
print("TEST 14: Recursive Helper Functions")

def sum_range(start, end):
    if start > end:
        return 0
    return start + sum_range(start + 1, end)

def product_range(start, end):
    if start > end:
        return 1
    return start * product_range(start + 1, end)

print(sum_range(1, 10))      # Expected: 55
print(sum_range(5, 10))      # Expected: 45
print(product_range(1, 5))   # Expected: 120
print(product_range(2, 4))   # Expected: 24

# ============================================================================
# TEST 15: Forward Declaration with Parameters
# ============================================================================
print("TEST 15: Forward Decl with Multiple Params")

def caller_multi(a, b):
    return callee_multi(a, b) + helper(a)

def callee_multi(x, y):
    return x * y

def helper(z):
    return z + 10

print(caller_multi(3, 4))    # Expected: 25
print(caller_multi(5, 2))    # Expected: 25

