# ============================================================================
# COMPILER ADVANCED TEST SUITE
# Tests user-defined functions, recursion, forward declarations, and C keyword escaping
# Designed specifically for COMPILER validation (not interpreter)
# ============================================================================

print("=== COMPILER ADVANCED TEST SUITE ===")
print("")

# ============================================================================
# TEST 1: Forward Declaration - Function Called Before Definition
# ============================================================================
print("TEST 1: Forward Declaration")

def caller():
    return callee(10)

def callee(x):
    return x * 2

print(caller())              # Expected: 20

# ============================================================================
# TEST 2: Mutual Recursion with Forward Reference
# ============================================================================
print("TEST 2: Mutual Recursion")

def even(n):
    if n == 0:
        return 1
    return odd(n - 1)

def odd(n):
    if n == 0:
        return 0
    return even(n - 1)

print(even(0))               # Expected: 1
print(even(4))               # Expected: 1
print(even(7))               # Expected: 0
print(odd(0))                # Expected: 0
print(odd(3))                # Expected: 1
print(odd(8))                # Expected: 0

# ============================================================================
# TEST 3: Deep Recursion with Multiple Parameters
# ============================================================================
print("TEST 3: Deep Recursion - Ackermann")

def ackermann(m, n):
    if m == 0:
        return n + 1
    if n == 0:
        return ackermann(m - 1, 1)
    return ackermann(m - 1, ackermann(m, n - 1))

print(ackermann(0, 5))       # Expected: 6
print(ackermann(1, 2))       # Expected: 4
print(ackermann(2, 2))       # Expected: 7
print(ackermann(3, 1))       # Expected: 13

