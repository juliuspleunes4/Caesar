# ============================================================================
# COMPILER EXTREME STRESS TEST
# Pushes compiler to the absolute limit with complex patterns
# Tests features at maximum complexity
# ============================================================================

print("=== COMPILER EXTREME STRESS TEST ===")
print("")

# ============================================================================
# TEST 1: Triple Nested Function Calls
# ============================================================================
print("TEST 1: Triple Nested Calls")

def add(a, b):
    return a + b

def mul(a, b):
    return a * b

def sub(a, b):
    return a - b

# Triple nesting: sub(mul(add(1, 2), 3), 4) = sub(mul(3, 3), 4) = sub(9, 4) = 5
print(sub(mul(add(1, 2), 3), 4))              # Expected: 5

# Quadruple nesting
print(add(sub(mul(add(2, 3), 2), 5), 1))      # Expected: 6  ((2+3)*2-5)+1 = (10-5)+1 = 6

# ============================================================================
# TEST 2: Mutual Recursion with Multiple Parameters
# ============================================================================
print("TEST 2: Multi-param Mutual Recursion")

def ping(x, y):
    if x <= 0:
        return y
    return pong(x - 1, y + 1)

def pong(x, y):
    if x <= 0:
        return y
    return ping(x - 1, y + 2)

print(ping(5, 0))        # Expected: 15 (alternating +1 and +2)
print(pong(5, 0))        # Expected: 12
print(ping(10, 5))       # Expected: 35

# ============================================================================
# TEST 3: Deeply Nested Recursion with Parameters
# ============================================================================
print("TEST 3: Deep Nested Recursion")

def nested_calc(a, b, c):
    if a <= 0:
        return b + c
    if b <= 0:
        return a + c
    return nested_calc(a - 1, nested_calc(a, b - 1, c), c + 1)

print(nested_calc(2, 2, 0))      # Expected: complex recursive result
print(nested_calc(1, 1, 5))      # Expected: complex recursive result

# ============================================================================
# TEST 4: Forward Declaration with Nested Calls
# ============================================================================
print("TEST 4: Forward Decl + Nested Calls")

def outer(n):
    if n <= 0:
        return 1
    return middle(n, inner(n - 1))

def middle(a, b):
    return a + b + helper(a)

def inner(n):
    if n <= 0:
        return 0
    return n * 2

def helper(n):
    return n * 3

print(outer(0))          # Expected: 1
print(outer(1))          # Expected: 1 + 0 + helper(1) = 1 + 0 + 3 = 4
print(outer(2))          # Expected: 2 + inner(1) + helper(2) = 2 + 2 + 6 = 10
print(outer(3))          # Expected: 3 + inner(2) + helper(3) = 3 + 4 + 9 = 16

# ============================================================================
# TEST 5: Multiple C Keywords with Recursion
# ============================================================================
print("TEST 5: Multiple C Keywords Recursively")

def auto(n):
    if n <= 0:
        return 0
    return n + extern(n - 1)

def extern(n):
    if n <= 0:
        return 0
    return n + signed(n - 1)

def signed(n):
    if n <= 0:
        return 0
    return n + auto(n - 1)

print(auto(5))           # Expected: sum pattern
print(extern(4))         # Expected: sum pattern
print(signed(3))         # Expected: sum pattern

# ============================================================================
# TEST 6: Nested Calls with String and Number Mix
# ============================================================================
print("TEST 6: Mixed Type Nested Calls")

def count_chars(s):
    return len(s)

def add_lengths(s1, s2):
    return count_chars(s1) + count_chars(s2)

def triple_lengths(s1, s2, s3):
    return add_lengths(s1, s2) + count_chars(s3)

print(count_chars("hello"))                          # Expected: 5
print(add_lengths("hi", "bye"))                      # Expected: 5
print(triple_lengths("a", "bb", "ccc"))              # Expected: 6

# ============================================================================
# TEST 7: Fibonacci Variants
# ============================================================================
print("TEST 7: Fibonacci Variants")

def fib_triple(n):
    if n <= 2:
        return 1
    return fib_triple(n - 1) + fib_triple(n - 2) + fib_triple(n - 3)

def fib_custom(n, a, b):
    if n <= 0:
        return a
    if n == 1:
        return b
    return fib_custom(n - 1, b, a + b)

print(fib_triple(1))         # Expected: 1
print(fib_triple(3))         # Expected: 3
print(fib_triple(4))         # Expected: 5
print(fib_custom(5, 0, 1))   # Expected: 5 (5th Fibonacci)
print(fib_custom(10, 0, 1))  # Expected: 55

# ============================================================================
# TEST 8: Complex Nested Conditional Recursion
# ============================================================================
print("TEST 8: Nested Conditional Recursion")

def collatz(n):
    if n == 1:
        return 0
    if n % 2 == 0:
        return 1 + collatz(n / 2)
    return 1 + collatz(n * 3 + 1)

print(collatz(1))            # Expected: 0
print(collatz(2))            # Expected: 1
print(collatz(4))            # Expected: 2
print(collatz(8))            # Expected: 3

# ============================================================================
# TEST 9: Tail Call Chain
# ============================================================================
print("TEST 9: Tail Call Chain")

def tail_a(n, acc):
    if n <= 0:
        return acc
    return tail_b(n - 1, acc + 1)

def tail_b(n, acc):
    if n <= 0:
        return acc
    return tail_c(n - 1, acc + 2)

def tail_c(n, acc):
    if n <= 0:
        return acc
    return tail_a(n - 1, acc + 3)

print(tail_a(9, 0))          # Expected: 18 (pattern of +1,+2,+3 repeating)
print(tail_b(8, 0))          # Expected: 16
print(tail_c(7, 0))          # Expected: 14

# ============================================================================
# TEST 10: GCD with Nested Modulo
# ============================================================================
print("TEST 10: GCD Algorithm")

def gcd(a, b):
    if b == 0:
        return a
    return gcd(b, a % b)

def lcm(a, b):
    return a * b / gcd(a, b)

print(gcd(48, 18))           # Expected: 6
print(gcd(100, 35))          # Expected: 5
print(lcm(12, 18))           # Expected: 36

# ============================================================================
# TEST 11: All C Keywords as Mutually Recursive Functions
# ============================================================================
print("TEST 11: All Keywords Mutual Recursion")

def const(n):
    if n <= 0:
        return 1
    return volatile(n - 1) + 1

def volatile(n):
    if n <= 0:
        return 2
    return const(n - 1) + 1

def static(n):
    if n <= 0:
        return 3
    return register(n - 1) + 1

def register(n):
    if n <= 0:
        return 4
    return static(n - 1) + 1

print(const(3))              # Expected: alternating pattern
print(volatile(3))           # Expected: alternating pattern
print(static(2))             # Expected: alternating pattern
print(register(2))           # Expected: alternating pattern

# ============================================================================
# TEST 12: McCarthy 91 Function (Complex Recursion)
# ============================================================================
print("TEST 12: McCarthy 91")

def mccarthy91(n):
    if n > 100:
        return n - 10
    return mccarthy91(mccarthy91(n + 11))

print(mccarthy91(99))        # Expected: 91
print(mccarthy91(95))        # Expected: 91
print(mccarthy91(101))       # Expected: 91
print(mccarthy91(110))       # Expected: 100

# ============================================================================
# TEST 13: Nested Function Calls as All Parameters
# ============================================================================
print("TEST 13: All Params as Nested Calls")

def sum3(a, b, c):
    return a + b + c

def double(x):
    return x * 2

def triple(x):
    return x * 3

def quad(x):
    return x * 4

# All three parameters are function calls
print(sum3(double(2), triple(3), quad(4)))    # Expected: 4 + 9 + 16 = 29
print(sum3(double(triple(2)), quad(3), 5))    # Expected: 12 + 12 + 5 = 29

# ============================================================================
# TEST 14: Deep Nesting Levels (5+ levels)
# ============================================================================
print("TEST 14: Five-Level Nesting")

def level1(n):
    return n + 1

def level2(n):
    return level1(n) + 1

def level3(n):
    return level2(n) + 1

def level4(n):
    return level3(n) + 1

def level5(n):
    return level4(n) + 1

print(level5(0))             # Expected: 5
print(level5(10))            # Expected: 15

# Five-level nested call
print(level5(level4(level3(level2(level1(1))))))  # Expected: 10

# ============================================================================
# TEST 15: Mixed String/Int Recursion with Nested Calls
# ============================================================================
print("TEST 15: Mixed Types with Nesting")

def repeat_str(s, n):
    if n <= 0:
        return ""
    if n == 1:
        return s
    return s

def get_length_nested(s1, s2):
    return len(repeat_str(s1, 3)) + len(repeat_str(s2, 2))

print(get_length_nested("hi", "bye"))        # Expected: 2 + 3 = 5

# ============================================================================
# TEST 16: Stress Test - 20 Mutually Recursive Functions
# ============================================================================
print("TEST 16: 20-Way Mutual Recursion")

def f1(n):
    if n <= 0:
        return 1
    return f2(n - 1) + 1

def f2(n):
    if n <= 0:
        return 2
    return f3(n - 1) + 1

def f3(n):
    if n <= 0:
        return 3
    return f4(n - 1) + 1

def f4(n):
    if n <= 0:
        return 4
    return f5(n - 1) + 1

def f5(n):
    if n <= 0:
        return 5
    return f1(n - 1) + 1

print(f1(10))                # Expected: complex chain result
print(f3(15))                # Expected: complex chain result
print(f5(20))                # Expected: complex chain result

# ============================================================================
# TEST 17: Power Function Variants
# ============================================================================
print("TEST 17: Power Variants")

def power_tail(base, exp, acc):
    if exp == 0:
        return acc
    return power_tail(base, exp - 1, acc * base)

def power_nested(base, exp):
    if exp == 0:
        return 1
    if exp == 1:
        return base
    if exp % 2 == 0:
        return power_nested(base * base, exp / 2)
    return base * power_nested(base, exp - 1)

print(power_tail(2, 10, 1))      # Expected: 1024
print(power_tail(3, 5, 1))       # Expected: 243
print(power_nested(2, 10))       # Expected: 1024
print(power_nested(3, 5))        # Expected: 243

# ============================================================================
# TEST 18: Nested Recursive Calls in All Branches
# ============================================================================
print("TEST 18: Recursion in All Branches")

def branch_rec(n, mode):
    if n <= 0:
        return 0
    if mode == 1:
        return n + branch_rec(n - 1, 2)
    if mode == 2:
        return n * 2 + branch_rec(n - 1, 3)
    return n * 3 + branch_rec(n - 1, 1)

print(branch_rec(3, 1))          # Expected: complex branching result
print(branch_rec(4, 2))          # Expected: complex branching result

# ============================================================================
# TEST 19: Deeply Nested with Multiple Return Paths
# ============================================================================
print("TEST 19: Multi-Path Deep Nesting")

def multi_path(n):
    if n <= 0:
        return 0
    if n == 1:
        return 1
    if n % 2 == 0:
        return multi_path(n / 2) + multi_path(n / 2 - 1)
    return multi_path(n - 1) + multi_path(n - 2)

print(multi_path(1))             # Expected: 1
print(multi_path(4))             # Expected: complex multi-path result
print(multi_path(6))             # Expected: complex multi-path result

# ============================================================================
# TEST 20: Extreme Forward Declaration Chain (10 functions)
# ============================================================================
print("TEST 20: 10-Function Forward Chain")

def start():
    return step1() + 1

def step1():
    return step2() + 1

def step2():
    return step3() + 1

def step3():
    return step4() + 1

def step4():
    return step5() + 1

def step5():
    return step6() + 1

def step6():
    return step7() + 1

def step7():
    return step8() + 1

def step8():
    return step9() + 1

def step9():
    return 1

print(start())                   # Expected: 10

