{
  "name": "caesar-language-support",
  "displayName": "Caesar Language Support",
  "description": "Official Language Support for the Caesar Programming Language",
  "version": "0.0.2",
  "publisher": "juliuspleunes4",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliuspleunes4/Caesar.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:caesar"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes"
  ],
  "keywords": [
    "caesar",
    "programming-language",
    "syntax-highlighting",
    "interpreter"
  ],
  "icon": "images/caesar-icon.png",
  "contributes": {
    "languages": [
      {
        "id": "caesar",
        "aliases": [
          "Caesar",
          "caesar"
        ],
        "extensions": [
          ".csr",
          ".caesar",
          ".cae"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/caesar-icon.png",
          "dark": "./images/caesar-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "caesar",
        "scopeName": "source.caesar",
        "path": "./syntaxes/caesar.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "caesar",
        "path": "./snippets/caesar.json"
      }
    ],
    "themes": [
      {
        "label": "Caesar Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/caesar-dark-theme.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^2.21.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
